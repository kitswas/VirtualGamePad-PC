{
	"version": 3,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 21
	},
	"configurePresets": [
		{
			"name": "windows",
			"displayName": "Windows Multi-Config",
			"description": "Multi-config build for Windows",
			"generator": "Ninja Multi-Config",
			"binaryDir": "${sourceDir}/build-windows",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			}
		},
		{
			"name": "windows-installable",
			"displayName": "Windows Installable (installer/MSIX)",
			"description": "Stores settings in standard OS locations (PORTABLE_BUILD=OFF)",
			"inherits": "windows",
			"binaryDir": "${sourceDir}/build-windows-installable",
			"cacheVariables": {
				"PORTABLE_BUILD": "OFF"
			}
		},
		{
			"name": "linux-installable",
			"displayName": "Linux Installable (Flatpak/AppImage/deb)",
			"description": "Stores settings in standard OS locations (PORTABLE_BUILD=OFF)",
			"inherits": "linux",
			"binaryDir": "${sourceDir}/build-linux-installable",
			"cacheVariables": {
				"PORTABLE_BUILD": "OFF"
			}
		},
		{
			"name": "linux",
			"displayName": "Linux Multi-Config",
			"description": "Multi-config build for Linux",
			"generator": "Ninja Multi-Config",
			"binaryDir": "${sourceDir}/build-linux",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			}
		}
	],
	"buildPresets": [
		{
			"name": "Windows Installable Release",
			"configuration": "Release",
			"configurePreset": "windows-installable"
		},
		{
			"name": "Linux Installable Release",
			"configuration": "Release",
			"configurePreset": "linux-installable"
		},
		{
			"name": "Windows Portable Release",
			"configuration": "Release",
			"configurePreset": "windows"
		},
		{
			"name": "Windows Debug",
			"configuration": "Debug",
			"configurePreset": "windows"
		},
		{
			"name": "Linux Portable Release",
			"configuration": "Release",
			"configurePreset": "linux"
		},
		{
			"name": "Linux Debug",
			"configuration": "Debug",
			"configurePreset": "linux"
		}
	]
}