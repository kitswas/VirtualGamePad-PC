---
BasedOnStyle: Microsoft
IndentWidth: 4
TabWidth: 4
UseTab: Always
AllowShortIfStatementsOnASingleLine: false
AllowShortFunctionsOnASingleLine: false
AllowShortLambdasOnASingleLine: false
BinPackArguments: false 
BinPackParameters: OnePerLine 
# To force arguments onto their own lines when they break, make sure Clang doesn't 
# try to fit all of them onto the next line as a single block:
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false
BreakBeforeBraces: Allman
IndentCaseLabels: false
ColumnLimit: 108
# Keep long string literals whole: splitting them mid-directive (e.g. the udev
# rule in src/simulation/linux/gamepadSim.cpp) makes them unreadable. Where the
# line still does not fit, clang-format reflows the surrounding stream operator.
BreakStringLiterals: false
SortIncludes: true
IncludeBlocks: Regroup
SortUsingDeclarations: true
